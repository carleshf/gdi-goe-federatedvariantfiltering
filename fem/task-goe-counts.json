      { "id": "out_dir",  "type": "str", "default_value": "/sandbox", "position": 3, "prefix": "--out-dir",  "separate": true, "required": false },
      { "id": "cores",    "type": "int", "default_value": 2,          "position": 4, "prefix": "--cores",    "separate": true, "required": false }
